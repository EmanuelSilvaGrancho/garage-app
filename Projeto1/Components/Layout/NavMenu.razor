@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Gear Shift</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu"></span> Home
            </NavLink>
        </div>

        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Marcas">
                <span class="bi bi-tags-fill-nav-menu"></span> Marcas
            </NavLink>
        </div>

       
        <AuthorizeView Roles="Administrador">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="AtualizarMarcas">
                        <span class="bi bi-plus-square-fill-nav-menu"></span> Atualizar Marcas
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="TodosModelos">
                <span class="bi bi-box-seam-fill-nav-menu"></span> Modelos
            </NavLink>
        </div>

        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account/login">
                        <span class="bi bi-box-arrow-in-right-nav-menu"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="logout">
                        <span class="bi bi-box-arrow-left-nav-menu"></span> Logout
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

    </nav>
</div>